# Copy this file to .env and fill in your key.
# Then load it before starting the server:
#
#   PowerShell:   $env:OPENAI_API_KEY = "sk-..."
#   Or use a tool like python-dotenv if you add it to requirements.txt.
#
# NEVER commit a real key to git. .env is in .gitignore.

OPENAI_API_KEY=your_openai_api_key_here
